# Resend API Key (αποκτήστε το δωρεάν από το https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Το email παραλήπτη των αιτημάτων της φόρμας (το email του πελάτη)
CONTACT_EMAIL=info@ZILOLEX.gr

# Προαιρετικά: Επαληθευμένο email αποστολέα μόλις συνδεθεί το domain (π.χ. noreply@customdomain.gr)
# Για δοκιμές λειτουργεί αυτόματα με το onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev

# Production URL (π.χ. https://ZILOLEX.gr ή https://project.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
